{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gun-parts-index.schema.json",
  "title": "Per-part packs: a platform's index.json",
  "description": "Generated from js/glb.ts PARTS_INDEX_FIELDS: do not edit (npm run check:models -- --write). See docs/models.md.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "description": "Index format version (1)."
    },
    "platform": {
      "type": "string",
      "description": "The platform (gun id) the packs are for."
    },
    "src": {
      "type": "string",
      "description": "Hash of the recipe sources the packs came from (stale-pack detection)."
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every build slot seen in the platform's sweep: the ones `anchors` and `deltas` are keyed by."
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dep": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The build slots whose parts shape this tag: a pack's `key` lists a part for each, in this order."
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "A part id per `dep` slot (\"\" = the slot is empty; \"*\" = any part)."
                },
                "file": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "The pack's file under the platform folder; null when the tag is empty for this key."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The pack's file under the platform folder; null when the tag is empty for this key."
                },
                "tris": {
                  "oneOf": [
                    {
                      "type": "number",
                      "description": "Triangles in the pack."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Triangles in the pack."
                },
                "bytes": {
                  "oneOf": [
                    {
                      "type": "number",
                      "description": "File size in bytes."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "File size in bytes."
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            },
            "description": "The packs: the most specific matching key is used."
          }
        },
        "required": [
          "dep",
          "packs"
        ],
        "additionalProperties": false
      },
      "description": "Per mesh slot (tag): which build slots shape it and its packs."
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "description": "Offsets parts give other slots: \"<buildSlot>=<partId>\" -> { mount_<tag>: [forward, up, right] } (metres, added up over the build)."
    },
    "bases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "build": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "slot -> part id."
          },
          "info": {
            "description": "Leaf path (a/b/0) -> value."
          }
        },
        "required": [
          "build",
          "info"
        ],
        "additionalProperties": false
      },
      "description": "The three reference builds (default, loaded, loaded with sights) and their `info` as flat leaves (path -> value)."
    },
    "deltas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {}
      },
      "description": "\"<buildSlot>=<partId>\" -> per reference build: the info leaves that change (number: add; { set: v }; { del: 1 }), or null where not observed."
    },
    "exact": {
      "type": "object",
      "additionalProperties": {},
      "description": "Builds the delta sums get wrong: build key -> leaf -> value."
    },
    "totals": {
      "oneOf": [
        {
          "description": "Counts and bytes (informational)."
        },
        {
          "type": "null"
        }
      ],
      "description": "Counts and bytes (informational)."
    }
  },
  "required": [
    "version",
    "platform",
    "src",
    "slots",
    "tags",
    "anchors",
    "bases",
    "deltas",
    "exact"
  ],
  "additionalProperties": false
}

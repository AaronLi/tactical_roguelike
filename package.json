{
  "name": "breach-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Peer-to-peer co-op roguelike tactical FPS that runs in the browser. TypeScript (js/*.ts, compiled to dist/js/), Three.js for rendering, WebRTC (via PeerJS) for networking.",
  "scripts": {
    "build": "tsc -p .",
    "dev": "node tools/dev.js",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:strict": "tsc -p . --noEmit --strict",
    "bake:models": "tsc -p . && node tools/bake_models.mjs",
    "check:models": "tsc -p . && node tools/check_models.mjs",
    "test:models": "tsc -p . && node tools/check_models.mjs --selftest && node tools/check_models.test.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "0.149.0",
    "meshoptimizer": "^1.3.0",
    "three": "^0.149.0",
    "typescript": "^7.0.2"
  }
}
